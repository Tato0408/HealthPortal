<?xml version="1.0" encoding="utf-8"?>
<!-- Copia este archivo como Secrets.config (en la misma carpeta) y completa los valores.
     Secrets.config está en .gitignore: nunca se sube al repositorio. -->
<appSettings>
    <!-- Cuenta de Gmail usada para enviar códigos de verificación y contraseñas temporales -->
    <add key="SmtpUser" value="tu_correo@gmail.com" />
    <!-- Contraseña de aplicación de Gmail (no la contraseña normal de la cuenta) -->
    <add key="SmtpPassword" value="tu_contraseña_de_aplicacion" />
</appSettings>
