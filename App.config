<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="HealthPortal.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <connectionStrings>
        <add name="HealthPortal.Properties.Settings.ConnectionString" connectionString="Data Source=localhost;Initial Catalog=HealthPortal;Integrated Security=True" providerName="System.Data.SqlClient" />
        <add name="HealthPortal.Properties.Settings.db_aad48c_healthportalConnectionString" connectionString="Data Source=localhost;Initial Catalog=HealthPortal;Integrated Security=True" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <!-- Las credenciales del correo de envío viven en Secrets.config (no se sube al repositorio).
         Copia Secrets.example.config como Secrets.config y completa los valores. -->
    <appSettings file="Secrets.config">
        <add key="SmtpHost" value="smtp.gmail.com" />
        <add key="SmtpPort" value="587" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <userSettings>
        <HealthPortal.Properties.Settings>
            <setting name="RememberMeToken" serializeAs="String">
                <value />
            </setting>
        </HealthPortal.Properties.Settings>
    </userSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.ReportViewer.Common" publicKeyToken="89845dcd8080cc91" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.SqlServer.Types" publicKeyToken="89845dcd8080cc91" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-16.0.0.0" newVersion="16.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>